# 统一换行符，避免 Windows 上 checkout 后 gradlew 失效
* text=auto

*.kt      text eol=lf
*.kts     text eol=lf
*.xml     text eol=lf
*.md      text eol=lf
*.py      text eol=lf
gradlew   text eol=lf
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

*.png     binary
*.apk     binary
*.jar     binary
